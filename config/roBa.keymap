#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    scroll-layers = <10>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        child-lock {
            bindings = <&tog 8>;
            key-positions = <0 1 2 3>;
            timeout-ms = <100>;
        };

        single-quotes {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <5 6>;
            layers = <0 3>;
        };

        double-quotes {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <5 6 7>;
            layers = <0 3>;
        };

        back-quote {
            bindings = <&kp GRAVE>;
            key-positions = <17 18>;
            layers = <0 3>;
        };

        brackets {
            bindings = <&brackets>;
            key-positions = <14 17>;
            layers = <0 3>;
        };

        parentheses {
            bindings = <&parentheses>;
            key-positions = <4 5>;
            layers = <0 3>;
        };

        braces {
            bindings = <&braces>;
            key-positions = <26 29>;
            layers = <0 3>;
        };

        muhenkan {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <27 26>;
            layers = <0>;
        };

        henkan {
            bindings = <&kp INT_HENKAN>;
            key-positions = <28 29>;
            layers = <0>;
        };

        mb3 {
            bindings = <&mkp MB3>;
            key-positions = <18 19>;
            layers = <9>;
        };

        semi-colon {
            bindings = <&kp SEMICOLON>;
            key-positions = <16 28>;
            layers = <0 3 1>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <5 17>;
            layers = <0 3 1>;
        };

        back-slash {
            bindings = <&kp BACKSLASH>;
            key-positions = <20 32>;
            layers = <0 3 1>;
        };

        vertical-var {
            bindings = <&kp PIPE>;
            key-positions = <31 19>;
            layers = <0 3 1>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <18 30>;
            layers = <0 1 3>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <17 6 19>;
            layers = <0 3 1>;
        };
    };

    macros {
        brackets: brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "BRACKETS";
        };

        braces: braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT>;
            label = "BRACES";
        };

        parentheses: parentheses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "PARENTHESES";
        };

        window_left: window_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN &kp LEFT>;
            label = "WINDOW_LEFT";
        };

        window_right: window_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN &kp RIGHT>;
            label = "WINDOW_RIGHT";
        };

        window_up: window_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN &kp UP>;
            label = "WINDOW_UP";
        };

        window_down: window_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN &kp DOWN>;
            label = "WINDOW_DOWN";
        };

        screen_shot: screen_shot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>;
            label = "SCREEN_SHOT";
        };

        select_left: select_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT &kp LEFT>;
            label = "SELECT_LEFT";
        };

        select_right: select_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT &kp RIGHT>;
            label = "SELECT_RIGHT";
        };

        select_up: select_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT &kp UP>;
            label = "SELECT_UP";
        };

        select_down: select_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT &kp DOWN>;
            label = "SELECT_DOWN";
        };

        select_home: select_home {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT &kp HOME>;
            label = "SELECT_HOME";
        };

        select_end: select_end {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT &kp END>;
            label = "SELECT_END";
        };

        kakeru: kakeru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N1 &kp KP_N5>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "KAKERU";
        };

        waru: waru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N7>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "WARU";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R         &kp T                                      &kp Y      &kp U  &lt 0 I  &kp O   &kp P
&lt 4 A           &lt 5 S       &kp D         &kp F         &kp G        &none          &kp MINUS      &kp H      &kp J  &kp K    &kp L   &mo 2
&mt LEFT_SHIFT Z  &lt 6 X       &kp C         &kp V         &lt 7 B      &mkp MB3       &kp SLASH      &lt 1 N    &kp M  &mo 10   &mo 11  &lt 12 COMMA
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 3 ESCAPE  &lt 0 SPACE  &lt 1 TAB      &kp BACKSPACE  &kp ENTER                          &kp PERIOD
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        NUMBER {
            bindings = <
&kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N4        &kp KP_N5                                &kp KP_N6  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_N0
&trans     &trans     &kakeru    &kp KP_MULTIPLY  &kp KP_PLUS   &trans            &trans   &trans     &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp PERCENT
&trans     &trans     &waru      &kp KP_SLASH     &kp KP_MINUS  &kp KP_EQUAL      &trans   &trans     &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp COMMA
&kp COLON  &trans     &trans     &trans           &trans        &trans            &kp DEL  &trans                                      &kp DOT
            >;
        };

        FUNCTION {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                      &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11  &kp F12  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans   &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans   &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SYMBOL {
            bindings = <
&kp QUESTION  &trans           &kp EQUAL   &kp LA(ASTERISK)  &kp TILDE                      &kp INT_YEN    &kp UNDERSCORE  &trans         &trans            &kp KP_PLUS
&kp AT_SIGN   &kp SLASH        &kp DOLLAR  &trans            &trans     &trans      &trans  &kp HASH       &trans          &trans         &trans            &trans
&trans        &kp EXCLAMATION  &kp CARET   &trans            &trans     &trans      &trans  &kp AMPERSAND  &kp KP_MINUS    &kp LESS_THAN  &kp GREATER_THAN  &trans
&trans        &trans           &trans      &trans            &trans     &trans      &trans  &trans                                                          &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans  &trans                        &trans    &trans    &trans     &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans    &trans    &kp UP    &trans     &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp HOME  &kp LEFT  &kp DOWN  &kp RIGHT  &kp END  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans    &trans                                  &trans
            >;
        };

        SCREEN {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans        &trans        &trans         &trans  &screen_shot
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &window_up    &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &window_left  &window_down  &window_right  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                             &trans
            >;
        };

        SELECT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                            &trans        &trans        &trans         &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans        &trans        &select_up    &trans         &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans      &select_home  &select_left  &select_down  &select_right  &select_end  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans        &trans                                                  &trans
            >;
        };

        BLUETOOTH {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                  &bt BT_CLR
            >;
        };

        LOCK {
            bindings = <
&none  &none  &none  &none  &none                    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none                       &none
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &mkp MB5  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        MOUSE-SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        MOUSE-VERTIALDESKTOP {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        MOUSE-BROWSER {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
